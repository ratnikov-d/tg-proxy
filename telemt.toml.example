[general]
use_middle_proxy = true
log_level = "normal"

[general.modes]
classic = true
secure = false
tls = false

[server]
port = 443

[server.api]
enabled = true
listen = "127.0.0.1:9091"
whitelist = ["127.0.0.1/32", "::1/128"]

[censorship]
mask = false
tls_emulation = false

[access.users]
tproxy = "ЗАМЕНИТЬ_НА_32_HEX_СЕКРЕТ"
