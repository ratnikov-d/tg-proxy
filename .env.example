# Скопируйте этот файл в .env и заполните реальными значениями. .env в .gitignore.
#
# MTP_SECRET: 16 случайных байт в виде 32 hex-символов в нижнем регистре.
#   Linux:    head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n'
#   macOS:    openssl rand -hex 16
#   Windows (PowerShell 5+):
#     $b = New-Object byte[] 16; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); ($b | ForEach-Object { $_.ToString('x2') }) -join ''
#   Один и тот же секрет используется дважды: как SECRET для MTProxy и как
#   секрет профиля tproxy-server, который подставляется в profiles.json.
#   Никогда не оставляйте значение из примера ниже.
MTP_SECRET=00000000000000000000000000000000

# TAG: 32 hex-символа. Telegram ожидает тег, полученный у @MTProxybot;
# все нули отключают тег. Генерируется так же, как секрет.
MTP_TAG=00000000000000000000000000000000

# Количество рабочих процессов внутри официального образа MTProxy (по умолчанию 1).
MTP_WORKERS=1

# PUBLIC_HOSTNAME: домен сайта, который обслуживает Traefik; должен совпадать с DNS-записью.
PUBLIC_HOSTNAME=proxy.example.com
