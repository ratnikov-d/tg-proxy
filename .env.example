# Copy this file to .env and fill in real values. .env is gitignored.
#
# MTP_SECRET: 16 random bytes as 32 lowercase hex characters.
#   Linux:    head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n'
#   macOS:    openssl rand -hex 16
#   Windows (PowerShell 5+):
#     $b = New-Object byte[] 16; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); ($b | ForEach-Object { $_.ToString('x2') }) -join ''
#   The same secret is used twice: as MTProxy SECRET and as the tproxy-server
#   profile secret rendered into profiles.json. Never reuse the example below.
MTP_SECRET=00000000000000000000000000000000

# TAG: 32 hex characters. Telegram expects a tag from @MTProxybot;
# all zeros disables it. Generate the same way as the secret.
MTP_TAG=00000000000000000000000000000000

# Worker processes inside the official MTProxy image (default 1).
MTP_WORKERS=1

# PUBLIC_HOSTNAME: site hostname served by Traefik, must match the DNS record.
PUBLIC_HOSTNAME=proxy.example.com
