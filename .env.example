# Скопируй в .env и заполни. .env в .gitignore и в репозиторий не попадает.

# MTP_SECRET — 16 байт = 32 hex-символа. Это секрет MTProxy: его получает и
# бэкенд (classic-режим), и tproxy-web (уходит в profiles.json), поэтому
# менять его нужно одновременно везде.
#   Linux:    head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n'
#   macOS:    openssl rand -hex 16
#   Windows:  $b = New-Object byte[] 16; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); ($b | ForEach-Object { $_.ToString('x2') }) -join ''
MTP_SECRET=00000000000000000000000000000000

# PUBLIC_HOSTNAME — домен, который обслуживает Traefik и на который указывает
# DNS-запись. Он же попадает в клиентскую ссылку.
PUBLIC_HOSTNAME=proxy.example.com
